<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="FlowerWhisp.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource GraphiteBrush}" Padding="18,26,18,20">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10"><Ellipse Width="13" Height="13" Fill="{StaticResource CobaltBrush}" VerticalAlignment="Center" /><TextBlock Text="FlowerWhisp" Foreground="White" FontSize="21" FontWeight="SemiBold" /></StackPanel>
                    <TextBlock Text="SIGNAL LEDGER" Foreground="#A8B2C0" FontSize="10" CharacterSpacing="180" Margin="2,12,0,0" />
                </StackPanel>
                <NavigationView x:Name="LedgerNav" Grid.Row="1" IsBackButtonVisible="Collapsed" IsPaneOpen="True" PaneDisplayMode="Left" Background="Transparent" Foreground="White" SelectionChanged="OnNavSelectionChanged" Margin="-12,22,-12,16" AutomationProperties.Name="Signal Ledger navigation">
                    <NavigationView.MenuItems>
                        <NavigationViewItem Content="Dictations" Tag="Dictations"><NavigationViewItem.Icon><ImageIcon Source="Assets/SignalIcons/dictations.png" /></NavigationViewItem.Icon></NavigationViewItem>
                        <NavigationViewItem Content="Insights" Tag="Insights"><NavigationViewItem.Icon><ImageIcon Source="Assets/SignalIcons/insights.png" /></NavigationViewItem.Icon></NavigationViewItem>
                        <NavigationViewItem Content="Dictionary" Tag="Dictionary"><NavigationViewItem.Icon><ImageIcon Source="Assets/SignalIcons/dictionary.png" /></NavigationViewItem.Icon></NavigationViewItem>
                        <NavigationViewItem Content="Snippets" Tag="Snippets"><NavigationViewItem.Icon><ImageIcon Source="Assets/SignalIcons/snippets.png" /></NavigationViewItem.Icon></NavigationViewItem>
                        <NavigationViewItem Content="Styles" Tag="Styles"><NavigationViewItem.Icon><ImageIcon Source="Assets/SignalIcons/styles.png" /></NavigationViewItem.Icon></NavigationViewItem>
                        <NavigationViewItem Content="Transforms" Tag="Transforms"><NavigationViewItem.Icon><ImageIcon Source="Assets/SignalIcons/transforms.png" /></NavigationViewItem.Icon></NavigationViewItem>
                        <NavigationViewItem Content="Scratchpad" Tag="Scratchpad"><NavigationViewItem.Icon><ImageIcon Source="Assets/SignalIcons/scratchpad.png" /></NavigationViewItem.Icon></NavigationViewItem>
                    </NavigationView.MenuItems>
                </NavigationView>
                <StackPanel Grid.Row="2" Spacing="10">
                    <Border Background="#252B34" CornerRadius="12" Padding="12"><StackPanel Spacing="5"><TextBlock Text="CAPTURE" Foreground="#A8B2C0" FontSize="10" CharacterSpacing="140" /><TextBlock x:Name="SidebarCaptureStatus" Text="Ready · Hold" Foreground="White" FontSize="13" /><TextBlock Text="Ctrl + Win" Foreground="#A8B2C0" FontSize="12" /></StackPanel></Border>
                    <Button x:Name="SettingsButton" Content="Settings" Click="OnSettingsClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" Background="#303844" Foreground="White" AutomationProperties.Name="Open settings">
                        <Button.ContentTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="12"><Image Source="Assets/SignalIcons/settings.png" Width="20" Height="20" /><TextBlock Text="Settings" VerticalAlignment="Center" /></StackPanel></DataTemplate></Button.ContentTemplate>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer Grid.Column="1" Padding="38,30,48,44" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="1060" Spacing="22">
                <Grid>
                    <StackPanel><TextBlock x:Name="PageEyebrow" Text="DICTATIONS" FontSize="11" CharacterSpacing="160" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="PageTitle" Text="Your signal, captured." FontSize="34" FontWeight="SemiBold" Margin="0,5,0,0" /><TextBlock x:Name="PageSubtitle" Text="Local-first dictation with a quiet paper trail." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="15" Margin="0,5,0,0" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Top"><Button Content="Open pill" Click="OnOpenPillClick" Padding="14,9" AutomationProperties.Name="Open recording pill" /><Button x:Name="RecordButton" Content="Start recording" Click="OnRecordClick" Padding="18,10" Background="{StaticResource GraphiteBrush}" Foreground="White" AutomationProperties.Name="Start or stop recording" /></StackPanel>
                </Grid>
                <InfoBar x:Name="StatusInfo" IsOpen="True" Severity="Informational" Message="{Binding StatusText}" IsClosable="False" />

                <StackPanel x:Name="DictationsPanel" Spacing="18">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16" Padding="22" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="16"><Grid><StackPanel><TextBlock Text="Ready when you are" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="Hold Ctrl + Win to speak. Toggle mode confirms before insertion." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel><Image Source="Assets/SignalIcons/dictations.png" Width="42" Height="42" HorizontalAlignment="Right" /></Grid><ProgressBar x:Name="SignalProgress" Value="12" Maximum="100" Height="7" /><Grid><TextBlock Text="Today" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="TodayCountText" Text="0 dictations" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid></StackPanel></Border>
                    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Grid.Column="0" Padding="18" CornerRadius="12" Background="{ThemeResource LayerFillColorDefaultBrush}"><StackPanel><TextBlock Text="TODAY" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="10" CharacterSpacing="140" /><TextBlock x:Name="TodayStat" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock Text="dictations" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Border><Border Grid.Column="1" Padding="18" CornerRadius="12" Background="{ThemeResource LayerFillColorDefaultBrush}"><StackPanel><TextBlock Text="AUDIO" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="10" CharacterSpacing="140" /><TextBlock Text="0m 35s" FontSize="28" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock Text="captured today" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Border><Border Grid.Column="2" Padding="18" CornerRadius="12" Background="{ThemeResource LayerFillColorDefaultBrush}"><StackPanel><TextBlock Text="BACKEND" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="10" CharacterSpacing="140" /><TextBlock Text="Groq" FontSize="28" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock Text="whisper-large-v3-turbo" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" /></StackPanel></Border></Grid>
                    <TextBlock Text="RECENT SIGNALS" FontSize="11" CharacterSpacing="150" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,6,0,0" />
                    <ListView x:Name="DictationsList" ItemsSource="{Binding Dictations}" SelectionMode="None" IsItemClickEnabled="False" Background="Transparent" AutomationProperties.Name="Recent dictations"><ListView.ItemTemplate><DataTemplate><Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="18" Margin="0,0,0,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="6"><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding FinalText}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="{Binding Timestamp}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding Backend}" FontSize="12" Foreground="{StaticResource CobaltBrush}" /><TextBlock Text="{Binding Polish}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding Duration}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Button Content="Copy" Tag="{Binding}" Click="OnCopyDictationClick" Padding="10,7" /><Button Content="Delete" Tag="{Binding}" Click="OnDeleteDictationClick" Padding="10,7" /></StackPanel></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
                </StackPanel>

                <StackPanel x:Name="InsightsPanel" Visibility="Collapsed" Spacing="18">
                    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Grid.Column="0" Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel><TextBlock Text="42" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="signals this month" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="↑ 18% from last month" Foreground="{StaticResource CobaltBrush}" Margin="0,9,0,0" /></StackPanel></Border><Border Grid.Column="1" Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel><TextBlock Text="18m" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="spoken minutes" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="Most active · Wednesday" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,9,0,0" /></StackPanel></Border><Border Grid.Column="2" Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel><TextBlock Text="91%" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="inserted directly" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="4 copied for manual paste" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,9,0,0" /></StackPanel></Border></Grid>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="14" Padding="22"><StackPanel Spacing="17"><TextBlock Text="Activity rhythm" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="A private, text-free aggregate. Counts stay local even when history retention is disabled." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="12"><Border Width="70" Height="80" Background="#DCE6FF" CornerRadius="8" Padding="8"><StackPanel VerticalAlignment="Bottom"><TextBlock Text="12" FontWeight="SemiBold" /><TextBlock Text="Mon" FontSize="11" /></StackPanel></Border><Border Width="70" Height="80" Background="#B8CBFF" CornerRadius="8" Padding="8"><StackPanel VerticalAlignment="Bottom"><TextBlock Text="7" FontWeight="SemiBold" /><TextBlock Text="Tue" FontSize="11" /></StackPanel></Border><Border Width="70" Height="80" Background="#3565F2" CornerRadius="8" Padding="8"><StackPanel VerticalAlignment="Bottom"><TextBlock Text="15" Foreground="White" FontWeight="SemiBold" /><TextBlock Text="Wed" FontSize="11" Foreground="White" /></StackPanel></Border><Border Width="70" Height="80" Background="#EEF1F6" CornerRadius="8" Padding="8"><StackPanel VerticalAlignment="Bottom"><TextBlock Text="3" FontWeight="SemiBold" /><TextBlock Text="Thu" FontSize="11" /></StackPanel></Border><Border Width="70" Height="80" Background="#8DAAFF" CornerRadius="8" Padding="8"><StackPanel VerticalAlignment="Bottom"><TextBlock Text="11" FontWeight="SemiBold" /><TextBlock Text="Fri" FontSize="11" /></StackPanel></Border><Border Width="70" Height="80" Background="#F2F4F8" CornerRadius="8" Padding="8"><StackPanel VerticalAlignment="Bottom"><TextBlock Text="0" FontWeight="SemiBold" /><TextBlock Text="Sat" FontSize="11" /></StackPanel></Border><Border Width="70" Height="80" Background="#D4DDF3" CornerRadius="8" Padding="8"><StackPanel VerticalAlignment="Bottom"><TextBlock Text="5" FontWeight="SemiBold" /><TextBlock Text="Sun" FontSize="11" /></StackPanel></Border></StackPanel><TextBlock Text="Accessible table alternative" FontWeight="SemiBold" Margin="0,4,0,0" /><ListView ItemsSource="{Binding Heatmap}" SelectionMode="None" AutomationProperties.Name="Accessible activity table"><ListView.ItemTemplate><DataTemplate><Grid Margin="8,5"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Day}" /><TextBlock Grid.Column="1" Text="{Binding Count}" /><TextBlock Grid.Column="2" Text="dictations" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border>
                </StackPanel>

                <StackPanel x:Name="DictionaryPanel" Visibility="Collapsed" Spacing="18">
                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="DictionarySearchBox" PlaceholderText="Search phrases and replacements" TextChanged="OnDictionarySearchChanged" AutomationProperties.Name="Search dictionary" /><Button Grid.Column="1" Content="Add entry" Click="OnAddDictionaryClick" Padding="14,9" /><Button Grid.Column="2" Content="Import" Click="OnImportDictionaryClick" Padding="14,9" /></Grid>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="14" Padding="20"><StackPanel Spacing="13"><TextBlock Text="Your words, your rules" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="Protected names are applied before polishing and never leave this device." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBox x:Name="DictionaryPhraseBox" Header="Phrase" PlaceholderText="e.g. FlowerWhisp" /><TextBox x:Name="DictionaryReplacementBox" Grid.Column="1" Header="Replacement" PlaceholderText="Use exactly this text" /></Grid><ListView x:Name="DictionaryList" ItemsSource="{Binding DictionaryEntries}" SelectionMode="None" Background="Transparent" AutomationProperties.Name="Dictionary entries"><ListView.ItemTemplate><DataTemplate><Border Padding="11,8" Margin="0,2" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Phrase}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Replacement}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Protected}" Foreground="{StaticResource CobaltBrush}" /><Button Content="Remove" Tag="{Binding}" Click="OnRemoveDictionaryClick" Padding="9,5" /></StackPanel></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border>
                </StackPanel>

                <StackPanel x:Name="SnippetsPanel" Visibility="Collapsed" Spacing="18">
                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="SnippetNameBox" Header="Name" PlaceholderText="e.g. Follow up" /><Button Grid.Column="1" Content="New snippet" Click="OnAddSnippetClick" VerticalAlignment="Bottom" Padding="14,9" /></Grid>
                    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="14" Padding="18"><StackPanel Spacing="10"><TextBlock Text="Snippets" FontSize="19" FontWeight="SemiBold" /><ListView x:Name="SnippetsList" ItemsSource="{Binding Snippets}" SelectionChanged="OnSnippetSelectionChanged" Background="Transparent" AutomationProperties.Name="Snippet list"><ListView.ItemTemplate><DataTemplate><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Content}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Shortcut}" Foreground="{StaticResource CobaltBrush}" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border><Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="14" Padding="18"><StackPanel Spacing="12"><TextBlock Text="Preview" FontSize="19" FontWeight="SemiBold" /><TextBox x:Name="SnippetContentBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" PlaceholderText="Snippet text" AutomationProperties.Name="Snippet content" /><Button Content="Save changes" Click="OnSaveSnippetClick" HorizontalAlignment="Left" Padding="14,8" /><TextBlock Text="Insert with the shortcut, or use the action next to a saved dictation." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel></Border></Grid>
                </StackPanel>

                <StackPanel x:Name="StylesPanel" Visibility="Collapsed" Spacing="18">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="14" Padding="20"><StackPanel Spacing="14"><TextBlock Text="Make the voice yours" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="A style is a local instruction applied only when you choose polished output." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /><ComboBox x:Name="StyleCombo" Header="Active style" ItemsSource="{Binding Styles}" DisplayMemberPath="Name" SelectionChanged="OnStyleSelectionChanged" /><TextBox x:Name="StyleInstructionsBox" Header="Instructions" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" /><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Save style" Click="OnSaveStyleClick" Padding="14,8" /><Button Content="New style" Click="OnNewStyleClick" Padding="14,8" /></StackPanel></StackPanel></Border>
                    <ListView ItemsSource="{Binding Styles}" SelectionMode="None" Background="Transparent" AutomationProperties.Name="Style profiles"><ListView.ItemTemplate><DataTemplate><Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" /><TextBlock Text="{Binding Instructions}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding BuiltIn}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
                </StackPanel>

                <StackPanel x:Name="TransformsPanel" Visibility="Collapsed" Spacing="18">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="14" Padding="20"><StackPanel Spacing="11"><TextBlock Text="Deliberate cleanup" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="Transforms run locally on the transcript. Text-only polish needs an approved Groq key." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /><InfoBar IsOpen="True" Severity="Warning" Title="Polish provider not configured" Message="Connect a Groq key in Settings → Providers to enable text-only polish. The app will not silently switch models." IsClosable="False" /><CheckBox x:Name="PolishCheckBox" Content="Use polished output for the next dictation" IsChecked="{Binding PolishEnabled, Mode=TwoWay}" /><StackPanel Orientation="Horizontal" Spacing="22"><CheckBox Content="Remove filler words" IsChecked="{Binding CleanupFillerWords, Mode=TwoWay}" /><CheckBox Content="Sentence case" IsChecked="{Binding CleanupPunctuation, Mode=TwoWay}" /><CheckBox Content="Tighten paragraphs" IsChecked="{Binding CleanupParagraphs, Mode=TwoWay}" /></StackPanel></StackPanel></Border>
                    <ListView ItemsSource="{Binding Transforms}" SelectionMode="None" Background="Transparent" AutomationProperties.Name="Transform settings"><ListView.ItemTemplate><DataTemplate><Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" /><TextBlock Text="{Binding Description}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel><ToggleSwitch Grid.Column="1" IsOn="{Binding Enabled, Mode=TwoWay}" OffContent="Off" OnContent="On" /></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
                </StackPanel>

                <StackPanel x:Name="ScratchpadPanel" Visibility="Collapsed" Spacing="18">
                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="A private listening room" FontSize="21" FontWeight="SemiBold" /><Button Grid.Column="1" Content="Capture to scratchpad" Click="OnScratchCaptureClick" Padding="14,8" /><Button Grid.Column="2" Content="Export" Click="OnExportScratchpadClick" Padding="14,8" /></Grid>
                    <TextBlock Text="Edit the raw thought, compare a local cleanup, and export only when you choose." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="14" Padding="18"><StackPanel Spacing="10"><TextBlock Text="Raw capture" FontSize="16" FontWeight="SemiBold" /><TextBox x:Name="ScratchRawBox" Text="{Binding ScratchRaw, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="280" AutomationProperties.Name="Scratchpad raw editor" /><TextBlock Text="Never inserted · local workspace" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" /></StackPanel></Border><Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="14" Padding="18"><StackPanel Spacing="10"><TextBlock Text="Comparison" FontSize="16" FontWeight="SemiBold" /><TextBox x:Name="ScratchPolishedBox" Text="{Binding ScratchPolished, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="280" AutomationProperties.Name="Scratchpad comparison editor" /><TextBlock Text="Preview only · no provider key required" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" /></StackPanel></Border></Grid>
                </StackPanel>

                <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Spacing="10">
                    <TextBlock Text="Settings stay local and explicit." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
                    <Expander Header="General" IsExpanded="True"><StackPanel Spacing="12"><ToggleSwitch Header="Launch FlowerWhisp at sign-in" OffContent="Off" OnContent="On" /><ComboBox x:Name="DefaultLanguageCombo" Header="Default language" SelectedIndex="0"><ComboBoxItem Tag="auto" Content="Auto-detect" /><ComboBoxItem Tag="en" Content="English" /><ComboBoxItem Tag="hi" Content="Hindi" /></ComboBox><ComboBox x:Name="DefaultRetentionCombo" Header="Default retention" SelectedIndex="1"><ComboBoxItem Tag="KeepForever" Content="Keep forever" /><ComboBoxItem Tag="DeleteAfter24Hours" Content="Delete after 24 hours" /><ComboBoxItem Tag="NeverStore" Content="Never store" /></ComboBox><ToggleSwitch x:Name="AnalyticsToggle" Header="Privacy-safe local analytics" IsOn="True" /><Button Content="Save general settings" Click="OnSaveGeneralSettingsClick" HorizontalAlignment="Left" Padding="13,8" /></StackPanel></Expander>
                    <Expander Header="Pill"><StackPanel Spacing="12"><TextBlock Text="The pill is the fastest way to see recording state without stealing focus." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><RadioButtons Header="Default capture mode" SelectedIndex="0"><RadioButton Content="Hold · Ctrl + Win" /><RadioButton Content="Toggle · Ctrl + Win + Space" /><RadioButton Content="Scratchpad" /></RadioButtons><ToggleSwitch Header="Show confirmation before toggle insert" IsOn="True" /></StackPanel></Expander>
                    <Expander Header="Shortcuts"><StackPanel Spacing="10"><TextBlock Text="Hold to record" /><TextBox Text="Ctrl + Win" AutomationProperties.Name="Hold shortcut" /><TextBlock Text="Toggle to record" /><TextBox Text="Ctrl + Win + Space" AutomationProperties.Name="Toggle shortcut" /><Button Content="Reset shortcuts" HorizontalAlignment="Left" Padding="12,7" /></StackPanel></Expander>
                    <Expander Header="Audio"><StackPanel Spacing="12"><ComboBox Header="Microphone" SelectedIndex="0"><ComboBoxItem Content="Default system microphone" /><ComboBoxItem Content="No microphone detected" /></ComboBox><Slider Header="Input level" Minimum="0" Maximum="100" Value="72" /><ToggleSwitch Header="Play recording cues" IsOn="True" /></StackPanel></Expander>
                    <Expander Header="Providers"><StackPanel Spacing="12"><ComboBox x:Name="DefaultBackendCombo" Header="Default transcription backend" SelectedIndex="0"><ComboBoxItem Tag="Groq" Content="Groq cloud" /><ComboBoxItem Tag="LocalWhisper" Content="Local Whisper" /></ComboBox><InfoBar IsOpen="True" Severity="Informational" Title="Groq transcription" Message="Only Free-plan-compatible production models are exposed; authenticated organization access is checked when the key is saved." IsClosable="False" /><ComboBox x:Name="GroqSttModelCombo" Header="Groq speech model" SelectedIndex="0"><ComboBoxItem Tag="whisper-large-v3-turbo" Content="whisper-large-v3-turbo · default" /><ComboBoxItem Tag="whisper-large-v3" Content="whisper-large-v3 · accuracy" /></ComboBox><ToggleSwitch x:Name="PolishToggle" Header="Optional Groq text polish" IsOn="False" /><ComboBox x:Name="GroqPolishModelCombo" Header="Groq polish model" SelectedIndex="0"><ComboBoxItem Tag="openai/gpt-oss-20b" Content="openai/gpt-oss-20b · default" /><ComboBoxItem Tag="openai/gpt-oss-120b" Content="openai/gpt-oss-120b · advanced" /></ComboBox><PasswordBox x:Name="GroqApiKeyBox" Header="Groq API key" PlaceholderText="Stored with Windows DPAPI (the key is never written to settings.json)" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Validate and save key" Click="OnSaveGroqKeyClick" HorizontalAlignment="Left" Padding="13,8" /><Button Content="Clear saved key" Click="OnClearGroqKeyClick" HorizontalAlignment="Left" Padding="13,8" /></StackPanel><InfoBar x:Name="GroqProviderStatus" IsOpen="True" Severity="Informational" Title="Provider status" Message="Checking the local DPAPI store…" IsClosable="False" /><TextBlock Text="Provider changes are applied after restart; FlowerWhisp never silently substitutes another model." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel></Expander>
                    <Expander Header="Local Whisper"><StackPanel Spacing="12"><InfoBar IsOpen="True" Severity="Informational" Title="Opt-in sidecar" Message="Choose an existing local checkout. The app does not download a model or use a canned transcript." IsClosable="False" /><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="WhisperCheckoutBox" Header="Whisper checkout" PlaceholderText="Choose a local folder containing the whisper package" /><Button Grid.Column="1" Content="Browse" Click="OnBrowseWhisperCheckoutClick" VerticalAlignment="Bottom" Padding="13,8" /></Grid><ComboBox x:Name="WhisperModelCombo" Header="Model" SelectedIndex="0"><ComboBoxItem Tag="small" Content="small · multilingual · 4 GB safe tier" /><ComboBoxItem Tag="base" Content="base · multilingual" /></ComboBox><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Check local host" Click="OnCheckWhisperClick" HorizontalAlignment="Left" Padding="13,8" /><Button Content="Save settings" Click="OnSaveWhisperSettingsClick" HorizontalAlignment="Left" Padding="13,8" /></StackPanel><InfoBar x:Name="LocalWhisperStatus" IsOpen="True" Severity="Informational" Title="Local Whisper status" Message="No local checkout configured." IsClosable="False" /><TextBlock Text="Provider and checkout changes are applied explicitly on the next restart." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel></Expander>
                    <Expander Header="Language"><StackPanel Spacing="12"><TextBlock Text="Language hints improve names and code-switching without sending a glossary upstream." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /><AutoSuggestBox PlaceholderText="Add a language hint" /><Button Content="Add hint" HorizontalAlignment="Left" Padding="13,8" /></StackPanel></Expander>
                    <Expander Header="Privacy"><StackPanel Spacing="12"><ToggleSwitch Header="Keep whole dictations" IsOn="True" /><TextBlock Text="Never store keeps privacy-safe daily aggregates only. Audio, raw text, final text, prompts, credentials, and model caches are never included in aggregates." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Button Content="Open privacy data flow" HorizontalAlignment="Left" Padding="13,8" /></StackPanel></Expander>
                    <Expander Header="Appearance"><StackPanel Spacing="12"><RadioButtons Header="Theme" SelectedIndex="0"><RadioButton Content="Use Windows setting" /><RadioButton Content="Light" /><RadioButton Content="Dark" /></RadioButtons><ToggleSwitch Header="Reduce non-essential motion" IsOn="False" /></StackPanel></Expander>
                    <Expander Header="Data"><StackPanel Spacing="12"><Button Content="Export local ledger" HorizontalAlignment="Left" Padding="13,8" /><Button Content="Delete all saved dictations" HorizontalAlignment="Left" Padding="13,8" /><TextBlock Text="Exports omit credentials, machine paths, model caches, and audio unless you explicitly choose an audio export." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel></Expander>
                    <Expander Header="Updates"><StackPanel Spacing="10"><TextBlock Text="You are running the source-available development build." /><Button Content="Check for updates" HorizontalAlignment="Left" Padding="13,8" /></StackPanel></Expander>
                    <Expander Header="About"><StackPanel Spacing="10"><TextBlock Text="FlowerWhisp · Signal Ledger" FontWeight="SemiBold" /><TextBlock Text="Local-first Windows dictation with a calm, inspectable paper trail." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Apache License 2.0 · Windows 10 19041+ · WinUI 3 · .NET 10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Expander>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
