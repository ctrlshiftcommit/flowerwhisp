{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ctrlshiftcommit/flowerwhisp/blob/main/schemas/local-whisper-protocol.schema.json",
  "title": "FlowerWhisp local Whisper NDJSON protocol v1",
  "description": "One request or response JSON object per line. Responses correlate using requestId.",
  "oneOf": [
    { "$ref": "#/$defs/handshakeRequest" }, { "$ref": "#/$defs/transcribeRequest" },
    { "$ref": "#/$defs/cancelRequest" }, { "$ref": "#/$defs/shutdownRequest" },
    { "$ref": "#/$defs/handshakeResponse" }, { "$ref": "#/$defs/transcriptionResponse" }, { "$ref": "#/$defs/cancelledResponse" },
    { "$ref": "#/$defs/shutdownResponse" }, { "$ref": "#/$defs/errorResponse" }
  ],
  "$defs": {
    "requestId": { "type": ["string", "null"], "minLength": 1 },
    "baseRequest": { "type": "object", "required": ["type", "requestId"], "properties": { "type": { "type": "string" }, "requestId": { "type": "string", "minLength": 1 } } },
    "handshakeRequest": { "allOf": [{ "$ref": "#/$defs/baseRequest" }, { "properties": { "type": { "const": "handshake" }, "protocolVersion": { "const": 1 } } }] },
    "transcribeRequest": { "allOf": [{ "$ref": "#/$defs/baseRequest" }, { "required": ["audioPath"], "properties": { "type": { "const": "transcribe" }, "audioPath": { "type": "string", "minLength": 1 }, "language": { "type": "string" } } }] },
    "cancelRequest": { "allOf": [{ "$ref": "#/$defs/baseRequest" }, { "required": ["targetRequestId"], "properties": { "type": { "const": "cancel" }, "targetRequestId": { "type": "string", "minLength": 1 } } }] },
    "shutdownRequest": { "allOf": [{ "$ref": "#/$defs/baseRequest" }, { "properties": { "type": { "const": "shutdown" } } }] },
    "handshakeResponse": { "type": "object", "additionalProperties": false, "required": ["type", "requestId", "protocolVersion", "hostVersion", "model", "device", "multilingual", "ready"], "properties": { "type": { "const": "handshake" }, "requestId": { "type": "string", "minLength": 1 }, "protocolVersion": { "const": 1 }, "hostVersion": { "type": "string" }, "model": { "type": "string" }, "device": { "type": "string" }, "multilingual": { "type": "boolean" }, "ready": { "type": "boolean" } } },
    "transcriptionResponse": { "type": "object", "additionalProperties": false, "required": ["type", "requestId", "text", "segments"], "properties": { "type": { "const": "transcription" }, "requestId": { "type": "string", "minLength": 1 }, "text": { "type": "string" }, "language": { "type": ["string", "null"] }, "duration": { "type": ["number", "null"], "minimum": 0 }, "segments": { "type": "array", "items": { "$ref": "#/$defs/segment" } } } },
    "segment": { "type": "object", "additionalProperties": false, "required": ["start", "end", "text"], "properties": { "start": { "type": "number", "minimum": 0 }, "end": { "type": "number", "minimum": 0 }, "text": { "type": "string" } } },
    "cancelledResponse": { "type": "object", "additionalProperties": false, "required": ["type", "requestId", "ok"], "properties": { "type": { "const": "cancelled" }, "requestId": { "type": "string", "minLength": 1 }, "ok": { "const": true } } },
    "shutdownResponse": { "type": "object", "additionalProperties": false, "required": ["type", "requestId", "ok"], "properties": { "type": { "const": "shutdown" }, "requestId": { "type": "string", "minLength": 1 }, "ok": { "const": true } } },
    "errorResponse": { "type": "object", "additionalProperties": false, "required": ["type", "requestId", "code", "message"], "properties": { "type": { "const": "error" }, "requestId": { "type": ["string", "null"] }, "code": { "type": "string", "pattern": "^[a-z0-9_]+$" }, "message": { "type": "string" } } }
  }
}
