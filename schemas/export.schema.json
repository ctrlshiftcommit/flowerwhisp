{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ctrlshiftcommit/flowerwhisp/blob/main/schemas/export.schema.json",
  "title": "FlowerWhisp export",
  "description": "Versioned, allowlisted user-data export. Credentials, logs, runtime/model files, caches, machine paths, and device identifiers are intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "exportedAt", "dictations", "usageAggregates", "dictionary", "snippets", "styles", "transforms"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "dictations": {
      "type": "array",
      "items": { "$ref": "#/$defs/dictation" }
    },
    "usageAggregates": {
      "type": "array",
      "items": { "$ref": "#/$defs/usageAggregate" }
    },
    "dictionary": { "type": "array", "items": { "$ref": "#/$defs/dictionaryEntry" } },
    "snippets": { "type": "array", "items": { "$ref": "#/$defs/snippet" } },
    "styles": { "type": "array", "items": { "$ref": "#/$defs/style" } },
    "transforms": { "type": "array", "items": { "$ref": "#/$defs/transform" } }
  },
  "$defs": {
    "guid": { "type": "string", "format": "uuid" },
    "dictation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "createdAt", "rawText", "finalText", "backend", "polishMode", "retention", "durationSeconds"],
      "properties": {
        "id": { "$ref": "#/$defs/guid" }, "createdAt": { "type": "string", "format": "date-time" },
        "rawText": { "type": "string" }, "finalText": { "type": "string" },
        "backend": { "enum": ["Groq", "LocalWhisper"] },
        "polishMode": { "enum": ["Off", "Light", "Medium", "StyleProfile", "Custom"] },
        "retention": { "enum": ["KeepForever", "DeleteAfter24Hours", "NeverStore"] },
        "durationSeconds": { "type": "number", "minimum": 0 }, "language": { "type": ["string", "null"] }
      }
    },
    "usageAggregate": {
      "type": "object", "additionalProperties": false,
      "required": ["day", "dictationCount", "audioSeconds", "characterCount"],
      "properties": {
        "day": { "type": "string", "format": "date" }, "dictationCount": { "type": "integer", "minimum": 0 },
        "audioSeconds": { "type": "number", "minimum": 0 }, "characterCount": { "type": "integer", "minimum": 0 }
      }
    },
    "dictionaryEntry": {
      "type": "object", "additionalProperties": false, "required": ["id", "phrase", "replacement", "protected"],
      "properties": { "id": { "$ref": "#/$defs/guid" }, "phrase": { "type": "string" }, "replacement": { "type": "string" }, "protected": { "type": "boolean" } }
    },
    "snippet": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "content", "protected"],
      "properties": { "id": { "$ref": "#/$defs/guid" }, "name": { "type": "string" }, "content": { "type": "string" }, "protected": { "type": "boolean" } }
    },
    "style": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "instructions"],
      "properties": { "id": { "$ref": "#/$defs/guid" }, "name": { "type": "string" }, "instructions": { "type": "string" } }
    },
    "transform": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "description", "enabled"],
      "properties": { "id": { "$ref": "#/$defs/guid" }, "name": { "type": "string" }, "description": { "type": "string" }, "enabled": { "type": "boolean" } }
    }
  }
}
