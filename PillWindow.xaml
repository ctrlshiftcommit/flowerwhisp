<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="FlowerWhisp.PillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowerWhisp recording pill">
    <Border Background="#090B0F" CornerRadius="24" Padding="18,12">
        <Grid RowSpacing="9">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Ellipse x:Name="StateDot" Width="10" Height="10" Fill="#5D7EFF" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock x:Name="StateTitle" Text="Ready to record" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StateDescription" Text="Hold Ctrl + Win to speak. Release to finish." Foreground="#AAB2BF" FontSize="12"/>
                </StackPanel>
                <TextBlock x:Name="TimerText" Grid.Column="2" Text="00:00" Foreground="#AAB2BF" FontFamily="Cascadia Mono" VerticalAlignment="Center"/>
            </Grid>
            <ProgressBar x:Name="WaveProgress" Grid.Row="1" Value="14" Maximum="100" Height="5" Foreground="#5D7EFF"/>
            <Grid Grid.Row="2">
                <CheckBox x:Name="ToggleModeCheckBox" Content="Toggle" Checked="OnModeChanged" Unchecked="OnModeChanged" Foreground="#CBD2DC"/>
                <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right">
                    <StackPanel x:Name="ConfirmationPanel" Visibility="Collapsed" Orientation="Horizontal" Spacing="7">
                        <Button Content="Accept" Click="OnInsertClick" Background="#5D7EFF" Foreground="White" AutomationProperties.Name="Accept and insert"/>
                        <Button Content="Discard" Click="OnDiscardClick" AutomationProperties.Name="Discard recording"/>
                        <Button Content="Edit" Click="OnKeepEditingClick"/>
                    </StackPanel>
                    <Button x:Name="ActionButton" Content="Start" Click="OnActionClick"/>
                    <Button Content="Close" Click="OnCloseClick"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
